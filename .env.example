# Modelo de configuracao do banco de dados.
#
# Este arquivo VAI para o git: serve para qualquer pessoa do grupo saber
# QUAIS variaveis precisa definir. Nao coloque senha real aqui.
#
# Para usar: copie para .env e preencha com as suas credenciais.
#   cp .env.example .env

DB_NAME=clube_reservas
DB_USER=app_user
DB_PASSWORD=change_me
DB_HOST=192.168.56.30
DB_PORT=3306

# Chave usada para assinar o JWT de sessao.
# Gere a sua com:  openssl rand -base64 32
JWT_SECRET=DB_NAME=clube_reservas
DB_USER=app_user
DB_PASSWORD=admin
DB_HOST=192.168.56.30
DB_PORT=3306
JWT_SECRET=Gk3JIIcX9ewY0kw9CphWszttSxqokj19fg6eynWo/LU=

# Marca o cookie de sessao como Secure (so trafega por HTTPS).
COOKIE_SECURE=false
